# ── JIRA ──────────────────────────────────────────────
JIRA_BASE_URL=https://bearqforjiraqa.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-api-token-here

# ── LLM (pick one) ────────────────────────────────────
# Option A: Claude API
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-5-20251001

# Option B: Ollama (fully offline)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434

# ── Qdrant ────────────────────────────────────────────
# local = embedded in-process, no Docker/server needed (recommended for getting started)
# server = connect to running Qdrant server
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./data/qdrant_db
QDRANT_COLLECTION=qabuddy
# Only needed when QDRANT_MODE=server:
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ── Embedding ─────────────────────────────────────────
# bge-base-en-v1.5 = 430 MB, good quality, CPU-friendly (default)
# bge-large-en-v1.5 = 1.3 GB, better quality (needs 4+ GB RAM)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu

# ── Retrieval ─────────────────────────────────────────
TOP_K=8
HYBRID_ALPHA=0.6
